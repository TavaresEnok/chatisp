# Copie para .env e ajuste. Não commite segredos.
# Obrigatórias nos modos api, worker, migrate e all.

# development, test ou production
CHATISP_ENV=development

# URL do PostgreSQL. A senha abaixo é só um exemplo.
CHATISP_DATABASE_URL=postgres://chatisp:troque-esta-senha@127.0.0.1:5432/chatisp?sslmode=disable

# API HTTP e listener separado de métricas Prometheus.
CHATISP_HTTP_ADDR=127.0.0.1:8080
CHATISP_METRICS_ADDR=127.0.0.1:9090

# debug, info, warn ou error. Logs em JSON, sem conteúdo sensível.
CHATISP_LOG_LEVEL=info

# Entre 1s e 2m.
CHATISP_SHUTDOWN_TIMEOUT=15s

# Relativo ao diretório de trabalho, normalmente backend/.
CHATISP_MIGRATIONS_DIR=db/migrations
