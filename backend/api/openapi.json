{
  "components": {
    "schemas": {
      "AcceptInputBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "Senha inicial da conta.",
            "maxLength": 128,
            "type": "string"
          },
          "token": {
            "description": "Token de uso único recebido no convite.",
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "type": "object"
      },
      "AcceptedBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "Pedido recebido.",
            "enum": [
              "accepted"
            ],
            "examples": [
              "accepted"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Local do erro, como body.nome ou query.pagina.",
            "type": "string"
          },
          "message": {
            "description": "Mensagem do erro de campo, sem o valor enviado.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "HealthBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "ok quando o processo está vivo.",
            "enum": [
              "ok"
            ],
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "InviteBody": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "description": "Momento em que o convite deixa de valer.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "expires_at"
        ],
        "type": "object"
      },
      "InviteInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "E-mail convidado.",
            "maxLength": 320,
            "type": "string"
          },
          "role": {
            "description": "Papel concedido.",
            "enum": [
              "admin",
              "supervisor",
              "agent"
            ],
            "type": "string"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "E-mail da conta.",
            "maxLength": 320,
            "type": "string"
          },
          "password": {
            "description": "Senha da conta.",
            "maxLength": 128,
            "type": "string"
          },
          "tenant_id": {
            "description": "Provedor, quando a conta participa de mais de um.",
            "maxLength": 36,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "PrincipalBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "E-mail da conta.",
            "type": "string"
          },
          "expires_at": {
            "description": "Fim absoluto da sessão.",
            "format": "date-time",
            "type": "string"
          },
          "membership_id": {
            "description": "Vínculo usado nesta sessão.",
            "type": "string"
          },
          "role": {
            "description": "Papel no provedor.",
            "type": "string"
          },
          "session_id": {
            "description": "Identificador da sessão.",
            "type": "string"
          },
          "tenant_id": {
            "description": "Provedor da sessão.",
            "type": "string"
          },
          "user_id": {
            "description": "Usuário autenticado.",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "tenant_id",
          "membership_id",
          "role",
          "session_id",
          "expires_at"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "Explicação deste caso, sem segredos nem stack trace.",
            "examples": [
              "o caminho solicitado não existe"
            ],
            "type": "string"
          },
          "errors": {
            "description": "Erros por campo, sem o valor enviado.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "status": {
            "description": "Código HTTP.",
            "examples": [
              404
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Resumo curto e estável do problema.",
            "examples": [
              "Recurso não encontrado"
            ],
            "type": "string"
          },
          "type": {
            "description": "URI que identifica o tipo do problema.",
            "examples": [
              "urn:chatisp:problem:not-found"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ReadyBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "ready quando o processo pode receber tráfego.",
            "enum": [
              "ready"
            ],
            "examples": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ResetConfirmInputBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "Nova senha.",
            "maxLength": 128,
            "type": "string"
          },
          "token": {
            "description": "Token de uso único da recuperação.",
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "type": "object"
      },
      "ResetRequestInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "E-mail da conta.",
            "maxLength": 320,
            "type": "string"
          }
        },
        "type": "object"
      },
      "SessionBody": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "description": "Token de CSRF desta sessão. Também vai no cookie legível pelo painel.",
            "type": "string"
          },
          "email": {
            "description": "E-mail da conta.",
            "type": "string"
          },
          "expires_at": {
            "description": "Fim absoluto da sessão.",
            "format": "date-time",
            "type": "string"
          },
          "membership_id": {
            "description": "Vínculo usado nesta sessão.",
            "type": "string"
          },
          "role": {
            "description": "Papel no provedor.",
            "type": "string"
          },
          "session_id": {
            "description": "Identificador da sessão, distinto do cookie.",
            "type": "string"
          },
          "tenant_id": {
            "description": "Provedor da sessão.",
            "type": "string"
          },
          "user_id": {
            "description": "Usuário autenticado.",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "tenant_id",
          "membership_id",
          "role",
          "session_id",
          "csrf_token",
          "expires_at"
        ],
        "type": "object"
      },
      "SessionInfoBody": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "description": "Abertura da sessão.",
            "format": "date-time",
            "type": "string"
          },
          "current": {
            "description": "Verdadeiro na sessão que fez a consulta.",
            "type": "boolean"
          },
          "expires_at": {
            "description": "Fim absoluto da sessão.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Sessão.",
            "type": "string"
          },
          "user_id": {
            "description": "Usuário da sessão.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "created_at",
          "expires_at",
          "current"
        ],
        "type": "object"
      },
      "SessionListOutputBody": {
        "additionalProperties": false,
        "properties": {
          "sessions": {
            "description": "Sessões ainda válidas do provedor.",
            "items": {
              "$ref": "#/components/schemas/SessionInfoBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API HTTP do Chat ISP. Erros usam RFC 9457 (application/problem+json) e não incluem stack trace nem segredos.",
    "title": "Chat ISP",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/panel/invitations": {
      "post": {
        "description": "Somente administradores do provedor da sessão.",
        "operationId": "create-panel-invitation",
        "parameters": [
          {
            "description": "Cookie de sessão do painel.",
            "in": "cookie",
            "name": "__Host-session",
            "schema": {
              "description": "Cookie de sessão do painel.",
              "type": "string"
            }
          },
          {
            "description": "Token de CSRF vinculado à sessão.",
            "in": "header",
            "name": "X-CSRF-Token",
            "schema": {
              "description": "Token de CSRF vinculado à sessão.",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteBody"
                }
              }
            },
            "description": "Created"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Não autenticado"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Acesso negado"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflito"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Dados inválidos"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro interno"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serviço indisponível"
          }
        },
        "summary": "Convida um usuário",
        "tags": [
          "painel"
        ]
      }
    },
    "/api/panel/invitations/accept": {
      "post": {
        "description": "Consome o token de uso único e abre uma sessão.",
        "operationId": "accept-panel-invitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "Sucesso",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Requisição inválida"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Acesso negado"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Dados inválidos"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Muitas tentativas"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro interno"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serviço indisponível"
          }
        },
        "summary": "Aceita um convite",
        "tags": [
          "painel"
        ]
      }
    },
