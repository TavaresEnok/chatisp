{
  "components": {
    "schemas": {
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Local do erro, como body.nome ou query.pagina.",
            "type": "string"
          },
          "message": {
            "description": "Mensagem do erro de campo, sem o valor enviado.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "HealthBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "ok quando o processo está vivo.",
            "enum": [
              "ok"
            ],
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "Explicação deste caso, sem segredos nem stack trace.",
            "examples": [
              "o caminho solicitado não existe"
            ],
            "type": "string"
          },
          "errors": {
            "description": "Erros por campo, sem o valor enviado.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "status": {
            "description": "Código HTTP.",
            "examples": [
              404
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Resumo curto e estável do problema.",
            "examples": [
              "Recurso não encontrado"
            ],
            "type": "string"
          },
          "type": {
            "description": "URI que identifica o tipo do problema.",
            "examples": [
              "urn:chatisp:problem:not-found"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ReadyBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "ready quando o processo pode receber tráfego.",
            "enum": [
              "ready"
            ],
            "examples": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API HTTP do Chat ISP. Erros usam RFC 9457 (application/problem+json) e não incluem stack trace nem segredos.",
    "title": "Chat ISP",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Não consulta dependências. Use /readyz para saber se o processo pode receber tráfego.",
        "operationId": "get-healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            },
            "description": "Sucesso"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro interno"
          }
        },
        "summary": "Verifica se o processo está vivo",
        "tags": [
          "operacao"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Responde 503 enquanto o processo está encerrando ou ainda não ficou pronto.",
        "operationId": "get-readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyBody"
                }
              }
            },
            "description": "Sucesso"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro interno"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serviço indisponível"
          }
        },
        "summary": "Verifica se o processo pode receber tráfego",
        "tags": [
          "operacao"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Instância atual",
      "url": "/"
    }
  ]
}
