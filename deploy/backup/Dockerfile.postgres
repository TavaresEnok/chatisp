# PostgreSQL 18.6 (mesmo minor do compose.yaml) com pgBackRest do repositório PGDG que a imagem
# oficial já configura. O pgBackRest precisa ser uma versão que suporte PostgreSQL 18.
FROM postgres:18.6-trixie
RUN apt-get update \
	&& apt-get install -y --no-install-recommends pgbackrest \
	&& rm -rf /var/lib/apt/lists/* \
	&& mkdir -p /backup/repo /var/log/pgbackrest /var/spool/pgbackrest \
	&& chown -R postgres:postgres /backup /var/log/pgbackrest /var/spool/pgbackrest
