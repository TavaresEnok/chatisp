# PostgreSQL 18.6 com pgBackRest, base musl. Só para validação em Docker 20.10.9
# (seccomp nega clone3 à glibc nova). A imagem de instalação é Dockerfile.postgres.
FROM postgres:18.6-alpine
RUN apk add --no-cache pgbackrest \
	&& mkdir -p /backup/repo /var/log/pgbackrest /var/spool/pgbackrest \
	&& chown -R postgres:postgres /backup /var/log/pgbackrest /var/spool/pgbackrest
