# Private collection; set installation to the same BACKUP_INSTALLATION used by the scripts.
global:
  scrape_interval: 30s
  external_labels:
    installation: REPLACE_WITH_UNIQUE_INSTALLATION
rule_files:
  - /etc/prometheus/backup.rules.yml
  - /etc/prometheus/ops.rules.yml
alerting:
  alertmanagers:
    - static_configs:
        - targets: [alertmanager:9093]
scrape_configs:
  - job_name: chatisp-runtime
    static_configs:
      - targets: [chatisp-api:9090, chatisp-worker:9090]
        labels:
          installation: REPLACE_WITH_UNIQUE_INSTALLATION
  - job_name: chatisp-backup
    metrics_path: /backup-status.prom
    static_configs:
      - targets: [backup-metrics:8080]
