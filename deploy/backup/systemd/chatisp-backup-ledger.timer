# Exemplo de cadência, NÃO decisão de RPO: ajuste ao que o provedor definir na D2-07.
# Ative com: systemctl enable --now chatisp-backup-ledger.timer
[Unit]
Description=Agenda o backup ledger do Chat ISP

[Timer]
OnCalendar=hourly
Persistent=true
Unit=chatisp-backup@ledger.service

[Install]
WantedBy=timers.target
