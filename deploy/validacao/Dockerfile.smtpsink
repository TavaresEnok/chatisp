# Duplo de validação do SMTP (backend/cmd/smtpsink). Não é a imagem de instalação.
FROM golang:1.27.3-alpine AS build
WORKDIR /src/backend
COPY backend/ ./
ENV CGO_ENABLED=0
RUN go build -mod=vendor -trimpath -o /out/smtpsink ./cmd/smtpsink

FROM alpine:3.22
RUN adduser -D -u 1000 sink
COPY --from=build /out/smtpsink /usr/local/bin/smtpsink
USER 1000
EXPOSE 2525 8025
ENTRYPOINT ["smtpsink"]
