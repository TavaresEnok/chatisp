{
	admin off
	local_certs
	# Conexão sem SNI (por IP) recebe o certificado de localhost em vez de falhar no TLS.
	default_sni localhost
}

# Com só ":443" o emissor interno não tem nome para emitir e o handshake falha
# ("tlsv1 alert internal error"). Para um domínio próprio, acrescente-o a esta lista.
localhost:443, 127.0.0.1:443 {
	tls internal
	encode zstd gzip

	handle /api/* {
		reverse_proxy chatisp-api:8080
	}
	handle /healthz {
		reverse_proxy chatisp-api:8080
	}
	handle /readyz {
		reverse_proxy chatisp-api:8080
	}
	handle /metrics {
		reverse_proxy chatisp-api:9090
	}
	handle {
		root * /srv/panel
		try_files {path} /index.html
		file_server
	}
}
