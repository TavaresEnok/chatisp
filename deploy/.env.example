# Copie para deploy/.env antes do Compose. Estes valores são placeholders.
# Não grave senha real neste arquivo; o .env não é versionado.
# Só as variáveis listadas em deploy/compose.yaml chegam à aplicação.

# --- Banco (senhas dos papéis) ---
POSTGRES_PASSWORD=troque-esta-senha
CHATISP_OWNER_PASSWORD=troque-senha-owner
CHATISP_APP_PASSWORD=troque-senha-app
CHATISP_PLATFORM_PASSWORD=troque-senha-platform
CHATISP_INGRESS_PASSWORD=troque-senha-ingress
CHATISP_JOBS_PASSWORD=troque-senha-jobs

# --- Anel de chaves de dados: "versão:chave-base64-de-32-bytes" ---
# Gere com: echo "1:$(openssl rand -base64 32)". Guarde uma cópia fora do
# servidor: sem ela, segredos cifrados de um backup não podem ser lidos.
CHATISP_DATA_KEYS=1:troque-por-32-bytes-em-base64
CHATISP_DATA_KEY_VERSION=1

# --- Endereço público (laboratório: localhost com CA interna do Caddy) ---
# CHATISP_PANEL_ORIGINS precisa ser exatamente a origem que o navegador usa.
#CHATISP_SITE_HOST=localhost
#CHATISP_STORAGE_HOST=storage.localhost
#CHATISP_PUBLIC_BIND=127.0.0.1
#CHATISP_PUBLIC_PORT=8443
#CHATISP_PANEL_ORIGINS=https://localhost:8443
#CHATISP_ATTACHMENTS_S3_PUBLIC_ENDPOINT=https://storage.localhost:8443

# --- Anexos (Garage local; o storage-setup cria bucket e chave) ---
# Chave: GK + 24 hexadecimais (echo GK$(openssl rand -hex 12)).
# Segredo: 64 hexadecimais (openssl rand -hex 32).
CHATISP_ATTACHMENTS_S3_ACCESS_KEY=GK000000000000000000000000
CHATISP_ATTACHMENTS_S3_SECRET_KEY=troque-por-64-hexadecimais
#CHATISP_ATTACHMENTS_S3_BUCKET=chatisp-anexos

# --- E-mail transacional (convite e recuperação de senha) ---
# Sem SMTP o convite e a recuperação respondem que o e-mail está indisponível.
#CHATISP_SMTP_ADDR=smtp.exemplo.com.br:587
#CHATISP_SMTP_USERNAME=
#CHATISP_SMTP_PASSWORD=
#CHATISP_SMTP_FROM=chat@exemplo.com.br

# --- Meta (WhatsApp Cloud API) ---
# Desabilitada por padrão: envio falha com driver_indisponivel, sem rede.
# O envio oficial exige as quatro linhas abaixo, decididas na D2-03.
#CHATISP_META_VERIFY_TOKEN=
#CHATISP_META_OFFICIAL_DISPATCH=true
#CHATISP_META_GRAPH_VERSION=vNN.N
#CHATISP_META_PRIMARY_DOC_URL=https://developers.facebook.com/docs/whatsapp/cloud-api/

# --- Entrada durante suspensão (D2-08) ---
# Sem limites definidos: recusa novas entregas suspensas e grava alerta, sem 200.
# Habilite somente com limites positivos decididos pela operação, por tenant.
# Retidos não executam bot/distribuição/envio nem são retomados automaticamente.
#CHATISP_SUSPENDED_INGRESS_ENABLED=false
#CHATISP_SUSPENDED_INGRESS_MAX_DELIVERIES=
#CHATISP_SUSPENDED_INGRESS_MAX_BYTES=
