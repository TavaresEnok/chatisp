# Chave de ambiente: development, test ou production
CHATISP_ENV=development

# URLs do PostgreSQL por papel operacional (M2/River).
# Use placeholders e credenciais seguras geradas para o ambiente. Não grave senhas reais.
CHATISP_DATABASE_URL=postgres://chatisp_owner:troque-senha-owner@127.0.0.1:5432/chatisp?sslmode=disable
CHATISP_APP_DATABASE_URL=postgres://chatisp_app:troque-senha-app@127.0.0.1:5432/chatisp?sslmode=disable
CHATISP_PLATFORM_DATABASE_URL=postgres://chatisp_platform:troque-senha-platform@127.0.0.1:5432/chatisp?sslmode=disable
CHATISP_INGRESS_DATABASE_URL=postgres://chatisp_ingress:troque-senha-ingress@127.0.0.1:5432/chatisp?sslmode=disable
CHATISP_JOBS_DATABASE_URL=postgres://chatisp_jobs:troque-senha-jobs@127.0.0.1:5432/chatisp?sslmode=disable

# API HTTP e métricas Prometheus
CHATISP_HTTP_ADDR=127.0.0.1:8080
CHATISP_METRICS_ADDR=127.0.0.1:9090

# Origens autorizadas para o painel (CSRF / WebSocket)
CHATISP_PANEL_ORIGINS=https://localhost:8443

# Nível de log: debug, info, warn ou error (JSON)
CHATISP_LOG_LEVEL=info

# Tempo limite para encerramento gracioso (entre 1s e 2m)
CHATISP_SHUTDOWN_TIMEOUT=15s

# Diretório de migrações SQL (Goose)
CHATISP_MIGRATIONS_DIR=backend/db/migrations

# Chaves de dados para criptografia no banco (Envelope/AES-GCM 256-bit base64)
# Formato: id:base64_chave (chave de 32 bytes codificada em base64)
CHATISP_DATA_KEYS=1:dHJvcXVlLWNoYXZlLWJhc2U2NC0zMmJ5dGVzISEhISE=
CHATISP_DATA_KEY_VERSION=1

# Envio de e-mail (SMTP)
CHATISP_SMTP_ADDR=127.0.0.1:1025
CHATISP_SMTP_USERNAME=troque-usuario-smtp
CHATISP_SMTP_PASSWORD=troque-senha-smtp
CHATISP_SMTP_FROM=nao-responda@exemplo.local

# Modo de simulação Meta Cloud API (desenvolvimento/testes locais sem chamadas externas reais)
# Em produção, CHATISP_META_SIMULATION e CHATISP_META_STANDIN_URL são estritamente rejeitados.
CHATISP_META_SIMULATION=true
CHATISP_META_STANDIN_URL=http://127.0.0.1:9999
CHATISP_META_VERIFY_TOKEN=troque-token-verificacao-meta
CHATISP_META_APP_ID=troque-app-id-meta
